name: Build APK (Godot)

on:
  workflow_dispatch:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Export Android APK
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - name: Baixar o repositorio
        uses: actions/checkout@v4

      - name: Instalar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Instalar Android SDK
        uses: android-actions/setup-android@v3

      - name: Preparar versao
        shell: bash
        run: |
          if [[ "$GITHUB_REF" == refs/tags/v* ]]; then
            VERSION="${GITHUB_REF_NAME#v}"
          else
            VERSION="teste.${GITHUB_RUN_NUMBER}"
          fi
          VERSION_CODE=$((100000 + GITHUB_RUN_NUMBER))
          echo "VERSION=$VERSION" >> "$GITHUB_ENV"
          echo "VERSION_CODE=$VERSION_CODE" >> "$GITHUB_ENV"
          echo ">>> Versao: $VERSION ($VERSION_CODE)"

      - name: Instalar Godot 4.2.2 e templates Android
        shell: bash
        run: |
          set -euo pipefail
          VERSION="4.2.2"
          BASE="https://github.com/godotengine/godot-builds/releases/download/${VERSION}-stable"
          curl -fL --retry 3 --retry-delay 3 -o godot.zip "$BASE/Godot_v${VERSION}-stable_linux.x86_64.zip"
          curl -fL --retry 3 --retry-delay 3 -o templates.tpz "$BASE/Godot_v${VERSION}-stable_export_templates.tpz"
          unzip -tq godot.zip
          unzip -tq templates.tpz
          unzip -q godot.zip
          mv "Godot_v${VERSION}-stable_linux.x86_64" godot
          chmod +x godot
          mkdir -p "$HOME/.local/share/godot/export_templates" templates
          unzip -q templates.tpz -d templates
          mv templates/templates "$HOME/.local/share/godot/export_templates/${VERSION}.stable"
          ./godot --headless --version

      - name: Encontrar projeto Godot
        shell: bash
        run: |
          set -euo pipefail
          PROJECT_FILE="$(find . -path './.git' -prune -o -path './templates' -prune -o -name project.godot -print -quit)"
          if [[ -z "$PROJECT_FILE" ]]; then
            echo 'ERRO: project.godot nao encontrado. Envie os arquivos do projeto Godot para a raiz do repositorio.'
            exit 1
          fi
          PROJECT_DIR="$(dirname "$PROJECT_FILE")"
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo ">>> Projeto: $PROJECT_DIR"
          grep -n '^config/name=' "$PROJECT_FILE" || true

      - name: Preparar exportacao Android
        shell: bash
        run: |
          set -euo pipefail
          SDKMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          yes | "$SDKMANAGER" --licenses >/dev/null || true
          "$SDKMANAGER" 'platform-tools' 'platforms;android-34' 'build-tools;34.0.0'

          NAME="$(sed -n 's/^config\/name="\(.*\)"$/\1/p' "$PROJECT_DIR/project.godot" | head -n 1)"
          [[ -n "$NAME" ]] || NAME='Neon Dodge'
          SLUG="$(printf '%s' "$NAME" | tr -cd 'A-Za-z0-9')"
          [[ -n "$SLUG" ]] || SLUG='Game'
          [[ "$SLUG" =~ ^[0-9] ]] && SLUG="G$SLUG"
          PACKAGE="com.$(printf '%s' "$SLUG" | tr '[:upper:]' '[:lower:]').game"
          echo "GAME_NAME=$NAME" >> "$GITHUB_ENV"
          echo "APK_SLUG=$SLUG" >> "$GITHUB_ENV"
          echo "PACKAGE_NAME=$PACKAGE" >> "$GITHUB_ENV"

          mkdir -p "$HOME/.config/godot" "$GITHUB_WORKSPACE/out"
          keytool -genkeypair -keystore "$HOME/debug.keystore" -storepass android \
            -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 \
            -validity 10000 -dname 'CN=Android Debug,O=Android,C=US'
          cat > "$HOME/.config/godot/editor_settings-4.tres" <<SETTINGS
          [gd_resource type="EditorSettings" format=3]

          [resource]
          export/android/java_sdk_path = "$JAVA_HOME"
          export/android/android_sdk_path = "$ANDROID_HOME"
          export/android/debug_keystore = "$HOME/debug.keystore"
          export/android/debug_keystore_user = "androiddebugkey"
          export/android/debug_keystore_pass = "android"
          SETTINGS

          PRESET="$PROJECT_DIR/export_presets.cfg"
          cat > "$PRESET" <<PRESETCFG
          [preset.0]

          name="Android"
          platform="Android"
          runnable=true
          advanced_options=false
          dedicated_server=false
          custom_features=""
          export_filter="all_resources"
          include_filter=""
          exclude_filter="tests/*,tools/*,docs/*,*.md"
          export_path="out/game-debug.apk"
          encryption_include_filters=""
          encryption_exclude_filters=""
          encrypt_pck=false
          encrypt_directory=false

          [preset.0.options]

          custom_template/debug=""
          custom_template/release=""
          gradle_build/use_gradle_build=false
          gradle_build/export_format=0
          architectures/armeabi-v7a=false
          architectures/arm64-v8a=true
          architectures/x86=false
          architectures/x86_64=false
          version/code=$VERSION_CODE
          version/name="$VERSION"
          package/unique_name="$PACKAGE_NAME"
          package/name="$GAME_NAME"
          package/signed=true
          screen/immersive_mode=true
          permissions/internet=false
          PRESETCFG

          # Configuracao de compressao mobile exigida em projetos que usam VRAM compression.
          if grep -q '^textures/vram_compression/import_etc2_astc=' "$PROJECT_DIR/project.godot"; then
            sed -i 's/^textures\/vram_compression\/import_etc2_astc=.*/textures\/vram_compression\/import_etc2_astc=true/' "$PROJECT_DIR/project.godot"
          else
            if grep -q '^\[rendering\]' "$PROJECT_DIR/project.godot"; then
              sed -i '/^\[rendering\]/a textures/vram_compression/import_etc2_astc=true' "$PROJECT_DIR/project.godot"
            else
              printf '\n[rendering]\ntextures/vram_compression/import_etc2_astc=true\n' >> "$PROJECT_DIR/project.godot"
            fi
          fi
          cat "$PRESET"

      - name: Importar recursos Godot
        shell: bash
        run: ./godot --headless --path "$PROJECT_DIR" --editor --import

      - name: Exportar APK de debug
        shell: bash
        run: |
          set -o pipefail
          ./godot --headless --path "$PROJECT_DIR" --export-debug Android "$GITHUB_WORKSPACE/out/game-debug.apk" 2>&1 | tee "$GITHUB_WORKSPACE/export.log"
          test -s "$GITHUB_WORKSPACE/out/game-debug.apk"
          mv "$GITHUB_WORKSPACE/out/game-debug.apk" "$GITHUB_WORKSPACE/out/${APK_SLUG}-${VERSION}.apk"
          sha256sum "$GITHUB_WORKSPACE/out/${APK_SLUG}-${VERSION}.apk"

      - name: Guardar APK como Artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.APK_SLUG }}-${{ env.VERSION }}
          path: out/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Publicar Release ao criar tag v*
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh release create "$GITHUB_REF_NAME" out/*.apk \
            --title "$GAME_NAME $GITHUB_REF_NAME" \
            --notes 'APK de debug para teste pessoal. Pode ser necessario autorizar a instalacao de apps desta origem no Android.'

      - name: Guardar log de exportacao
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: godot-export-log
          path: export.log
          if-no-files-found: ignore
          retention-days: 7
